// Visit Somerset CMS — Prisma schema
// Postgres-backed (Railway). Point DATABASE_URL at any Postgres instance —
// Railway's own Postgres plugin is the simplest option for both dev and prod
// at this stage.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PageStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  ARCHIVED
}

enum ListingCategory {
  ACCOMMODATION
  FOOD_DRINK
  ATTRACTION
  EVENT
}

// Current levels are GROWTH, PARTNER, PREMIUM (see lib/membership.ts). The four
// Kentico-era values are kept so existing rows stay valid; they are mapped onto
// the three levels when read.
enum MembershipTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  GROWTH
  PARTNER
  PREMIUM
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique // SUPER_ADMIN | CONTENT_ADMIN | MEMBER | READ_ONLY
  name        String           @unique // "Super Admin", "Content Admin", "Member", "Read Only"
  description String?
  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique // e.g. "pages.publish"
  description String?
  roles       RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  avatarUrl    String?
  roleId       String
  role         Role     @relation(fields: [roleId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  pagesAuthored Page[]     @relation("PageAuthor")
  pagesOwned    Page[]     @relation("PageOwner")
  assignedPages Page[]     @relation("PageAssignedMember")
  auditLogs      AuditLog[]
  uploadedMedia  Media[]
  versions       Version[]
  pageTemplates  PageTemplate[]
  notifications  Notification[]
}

model Page {
  id                String     @id @default(cuid())
  title             String
  subtitle          String?
  slug              String     @unique
  seoTitle          String?
  seoDescription    String?
  heroImageUrl      String?
  galleryUrls       String? // JSON-encoded string[]
  bodyContent       String?
  callToActionLabel String?
  callToActionUrl   String?
  customFields      String? // JSON-encoded key/value pairs
  status            PageStatus @default(DRAFT)
  isSection         Boolean    @default(false) // true = folder/section node, not an editable page
  sortOrder         Int        @default(0)

  parentId String?
  parent   Page?   @relation("PageTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Page[]  @relation("PageTree")

  // A tree location that just points at another page's real content — mirrors
  // Kentico's "linked document" pattern, where the same business/attraction
  // appears under multiple categories without duplicating the content itself.
  linkedPageId String?
  linkedPage   Page?   @relation("PageLink", fields: [linkedPageId], references: [id], onDelete: SetNull)
  linkedFrom   Page[]  @relation("PageLink")

  authorId String?
  author   User?   @relation("PageAuthor", fields: [authorId], references: [id])
  ownerId  String?
  owner    User?   @relation("PageOwner", fields: [ownerId], references: [id])

  assignedMemberId String?
  assignedMember   User?   @relation("PageAssignedMember", fields: [assignedMemberId], references: [id])
  assignedTeam     String?
  visibility       String  @default("public") // public | member-only | internal

  publishDate DateTime?
  expiryDate  DateTime?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tags          Tag[]          @relation("PageTags")
  categories    Category[]     @relation("PageCategories")
  contentBlocks ContentBlock[]
  auditLogs     AuditLog[]
  versions      Version[]

  seoKeywords       String?
  canonicalUrl      String?
  ogTitle           String?
  ogDescription     String?
  socialShareImage  String?
  schemaMarkup      String? // JSON-LD, stored as text

  // Business/member pages (e.g. a business's own listing page)
  tagline        String?
  membershipTier MembershipTier?

  rooms   Room[]
  reviews Review[]

  @@index([parentId])
  @@index([assignedMemberId])
}

// A bookable room/unit on an accommodation page. Entered by the assigned
// member (or an admin) via the page editor — the consumer-facing detail page
// only shows a "Rooms available" section once at least one of these exists.
model Room {
  id            String   @id @default(cuid())
  pageId        String
  page          Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  imageUrl      String?
  priceLabel    String? // free-text, e.g. "£145/night" — matches Listing.priceLabel
  features      String? // JSON-encoded string[], e.g. ["Free WiFi", "Dog friendly"]
  bookingUrl    String? // this room's own booking link (falls back to the listing's)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// A guest review on a page. Entered by the assigned member/admin — the
// consumer-facing detail page only shows a "Reviews" section once at least
// one of these exists.
model Review {
  id          String    @id @default(cuid())
  pageId      String
  page        Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  authorName  String
  rating      Int // 1-5
  quote       String
  reviewDate  DateTime?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
}

model ContentBlock {
  id        String   @id @default(cuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type      String // hero | text | gallery | cards | video | accordion | testimonials | faq | cta_banner | map
  sortOrder Int      @default(0)
  config    String // JSON-encoded block-specific fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  pages Page[] @relation("PageCategories")
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  pages Page[] @relation("PageTags")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  pageId    String?
  page      Page?    @relation(fields: [pageId], references: [id])
  action    String // created | updated | published | unpublished | archived | restored | deleted | cloned
  details   String?
  createdAt DateTime @default(now())
}

// Per-user, in-app only (no email/push) — generated on assignment and
// workflow transitions (see notifyAssignment/notifySubmittedForReview/
// notifyPublished in lib/data/notifications.ts).
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  pageId    String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model MediaFolder {
  id        String        @id @default(cuid())
  name      String
  parentId  String?
  parent    MediaFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  MediaFolder[] @relation("FolderTree")
  media     Media[]
  createdAt DateTime      @default(now())
}

model Media {
  id           String       @id @default(cuid())
  filename     String
  url          String
  mimeType     String
  size         Int
  kind         String // image | pdf | video | document
  tagsCsv      String?
  folderId     String?
  folder       MediaFolder? @relation(fields: [folderId], references: [id])
  uploadedById String?
  uploadedBy   User?        @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime     @default(now())
}

model FacilityGroup {
  id         String     @id @default(cuid())
  name       String     @unique
  sortOrder  Int        @default(0)
  facilities Facility[]
}

model Facility {
  id                  String         @id @default(cuid())
  name                String
  groupId             String?
  group               FacilityGroup? @relation(fields: [groupId], references: [id])
  mapFilter           Boolean        @default(false)
  filterGeneral       Boolean        @default(false)
  filterAccommodation Boolean        @default(false)
  listings            Listing[]      @relation("ListingFacilities")

  @@unique([name, groupId])
}

model Location {
  id          String   @id @default(cuid())
  name        String   @unique
  latitude    Float
  longitude   Float
  radiusMiles Int?
  sortOrder   Int      @default(0)
}

model MembershipTierDefinition {
  id                  String         @id @default(cuid())
  tier                MembershipTier @unique
  name                String
  priceLabel          String?
  searchPriorityLabel String?
  sortOrder           Int            @default(0)
  features            String // JSON-encoded feature-flag set (imported from Kentico)
}

model Listing {
  id             String          @id @default(cuid())
  category       ListingCategory
  name           String
  summary        String?
  description    String?
  imageUrl       String?
  location       String?
  facilities     Facility[]      @relation("ListingFacilities")
  priceLabel     String?
  rating         Float?
  reviewCount    Int?
  membershipTier MembershipTier?
  externalUrl    String?
  startDate      DateTime?
  endDate        DateTime?
  sortOrder      Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model PageTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  blocks      String // JSON-encoded array of { type, config }
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Version {
  id            String   @id @default(cuid())
  pageId        String
  page          Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  versionNumber Int
  editorId      String?
  editor        User?    @relation(fields: [editorId], references: [id])
  snapshot      String // JSON snapshot of page fields + content blocks at save time
  changeSummary String?
  createdAt     DateTime @default(now())
}

// Public newsletter signups from the site footer (Phase 12). Additive model —
// created by `prisma db push` on deploy, never touches existing tables.
model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String? // e.g. "footer", "home"
  createdAt DateTime @default(now())
}

// A visitor's stay enquiry sent to a listing (Phase 12). There is no live
// availability engine — dates are a request the business confirms by hand.
model BookingRequest {
  id        String   @id @default(cuid())
  pageId    String
  pageTitle String
  pageSlug  String
  name      String
  email     String
  phone     String?
  checkIn   String? // ISO date string, as entered
  checkOut  String?
  guests    String?
  message   String?
  status    String   @default("NEW") // NEW | HANDLED
  createdAt DateTime @default(now())

  @@index([pageId])
  @@index([createdAt])
}

// Site-wide settings edited in the CMS "Master page" tab (header, main
// navigation, footer). One JSON document per key; additive model.
model SiteSetting {
  key         String   @id
  value       String // JSON
  updatedById String?
  updatedAt   DateTime @updatedAt
}

// A member's proposed edit to a listing. The live page is never touched until
// the team approves it (status SUBMITTED -> APPROVED applies it).
model ChangeRequest {
  id          String    @id @default(cuid())
  pageId      String
  authorId    String
  status      String    @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | REJECTED
  proposal    String // JSON, see lib/data/change-requests.ts
  note        String? // reviewer's reason when rejected
  decidedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  submittedAt DateTime?
  decidedAt   DateTime?

  @@index([pageId, status])
  @@index([status])
}

// A new listing, event or offer proposed by a member. Nothing is created on
// the site until the team approves it (see lib/data/submissions.ts).
model Submission {
  id           String    @id @default(cuid())
  kind         String // LISTING | EVENT | OFFER
  authorId     String
  status       String    @default("DRAFT") // DRAFT | SUBMITTED | APPROVED | REJECTED
  title        String
  data         String // JSON
  note         String? // reviewer's reason when sent back
  resultPageId String? // the page created on approval
  decidedById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  submittedAt  DateTime?
  decidedAt    DateTime?

  @@index([status])
  @@index([authorId])
}

// A special offer shown on a listing page. Created when a member's offer
// submission is approved.
model Offer {
  id          String    @id @default(cuid())
  pageId      String
  title       String
  description String?
  url         String?
  validFrom   DateTime?
  validTo     DateTime?
  createdAt   DateTime  @default(now())

  @@index([pageId])
}

// Real, simple view counting for listing pages that belong to a member.
model PageView {
  pageId String
  day    String // yyyy-mm-dd
  views  Int    @default(0)

  @@id([pageId, day])
}

// One row per placement per week requested through "Bookable spaces". The
// team confirms and invoices; there is no card payment on this site yet.
model AdSlotBooking {
  id         String   @id @default(cuid())
  ref        String
  memberId   String
  pageId     String // the listing being promoted
  placement  String // key from lib/ad-spaces.ts
  weekStart  String // yyyy-mm-dd (a Monday)
  pricePence Int
  status     String   @default("REQUESTED") // REQUESTED | CONFIRMED | CANCELLED
  poNumber   String?
  createdAt  DateTime @default(now())

  @@index([placement, weekStart])
  @@index([memberId])
  @@index([ref])
}
